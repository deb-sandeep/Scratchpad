    <profiles>
        <!--
          Standalone, shareable jar for the attendance simulator only:
            mvn -P attendance-app package -DskipTests
          produces target/attendance-simulator.jar  (run: java -jar attendance-simulator.jar)
        -->
        <profile>
            <id>attendance-app</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>3.2.4</version>
                        <executions>
                            <execution>
                                <id>attendance-app</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <configuration>
                                    <outputFile>${project.build.directory}/attendance-simulator.jar</outputFile>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <artifactSet>
                                        <includes>
                                            <include>com.sandy.scratchpad:scratchpad</include>
                                            <include>com.fasterxml.jackson.core:*</include>
                                            <include>org.slf4j:slf4j-api</include>
                                            <include>ch.qos.logback:*</include>
                                        </includes>
                                    </artifactSet>
                                    <filters>
                                        <filter>
                                            <artifact>com.sandy.scratchpad:scratchpad</artifact>
                                            <includes>
                                                <include>com/sandy/scratchpad/attendance/**</include>
                                                <include>attendance/**</include>
                                            </includes>
                                        </filter>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>module-info.class</exclude>
                                                <exclude>META-INF/versions/*/module-info.class</exclude>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                                <exclude>META-INF/MANIFEST.MF</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <mainClass>com.sandy.scratchpad.attendance.AttendanceSimulator</mainClass>
                                            <manifestEntries>
                                                <Multi-Release>true</Multi-Release>
                                                <Implementation-Title>Attendance Simulator</Implementation-Title>
                                            </manifestEntries>
                                        </transformer>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                                            <resource>logback.xml</resource>
                                            <file>src/main/packaging/attendance/logback.xml</file>
                                        </transformer>
                                    </transformers>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
