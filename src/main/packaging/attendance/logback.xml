<configuration>
    <!-- Logging for the standalone attendance-simulator jar -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${user.home}/.attendance/attendance.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
